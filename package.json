{
  "name": "@onyx-robotics/agent",
  "version": "0.1.15",
  "packageManager": "bun@1.3.13",
  "description": "Onyx agent CLI and packaged agent skill for local research workflows.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-robotics/onyx-agent.git"
  },
  "homepage": "https://onyxresearch.ai",
  "bugs": {
    "url": "https://github.com/onyx-robotics/onyx-agent/issues"
  },
  "bin": {
    "onyx": "bin/onyx.js",
    "onyx-worker": "bin/onyx-worker.js"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "assets",
    "bin",
    "src",
    "skills",
    "prompts",
    "scripts/install.sh",
    "package.json"
  ],
  "scripts": {
    "build:release": "bun scripts/build-release.ts",
    "verify:release-analytics": "bun scripts/verify-release-analytics.ts",
    "ci": "bun run verify:lockfile && bun run lint && bun run typecheck && bun run test",
    "generate:skill-content": "bun scripts/generate-skill-content.ts",
    "generate:worker-prompt-content": "bun scripts/generate-worker-prompt-content.ts",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:lockfile": "bun scripts/verify-lockfile.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "posthog-node": "^5.46.1",
    "zod": "^4.1.13"
  },
  "optionalDependencies": {
    "@napi-rs/keyring-darwin-arm64": "1.3.0",
    "@napi-rs/keyring-darwin-x64": "1.3.0",
    "@napi-rs/keyring-linux-arm64-gnu": "1.3.0",
    "@napi-rs/keyring-linux-x64-gnu": "1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.0",
    "@types/node": "^25.1.0",
    "eslint": "^9.39.2",
    "typescript-eslint": "^8.46.4",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./src/onyx.ts",
    "./protocol": "./src/protocol/index.ts"
  }
}
