{
  "name": "@onyx-robotics/agent",
  "version": "0.3.0",
  "description": "Onyx from a shell: the onyx CLI, a TypeScript SDK for the Onyx API, and the research runtime that runs agents on your machine.",
  "keywords": [
    "onyx",
    "cli",
    "sdk",
    "research",
    "agents"
  ],
  "license": "Apache-2.0",
  "homepage": "https://onyxresearch.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-robotics/onyx-agent.git"
  },
  "bugs": {
    "url": "https://github.com/onyx-robotics/onyx-agent/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.11.0"
  },
  "bin": {
    "onyx": "src/cli/main.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "bun": "./src/sdk/index.ts",
      "default": "./dist/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "skills",
    "GETTING_STARTED.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "build": "bun scripts/build.ts",
    "compile": "bun scripts/compile.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "onyx": "bun --no-env-file src/cli/main.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
